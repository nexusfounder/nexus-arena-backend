{
  "rules": {
    "live_tournaments": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
      ".indexOn": ["status", "game", "created_at"]
    },
    "tournaments": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
      ".indexOn": ["status", "game", "created_at"]
    },
    "matches": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["tournament_id", "status"]
    },
    "leaderboard": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
      ".indexOn": ["score", "rank"]
    },
    "moogold_catalog": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)"
    },
    "moogold_orders": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "user_active_session": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "user_sessions": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "feedback": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.admin === true)",
      "$feedbackId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || data.child('user_id').val() === auth.uid)",
        ".write": "auth != null"
      }
    },
    "match_proofs": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    }
  }
}